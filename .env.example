# Copy to .env (git-ignored) and replace every value. Never commit real secrets.
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator-password
POSTGRES_APP_PASSWORD=change-me-app-password
REDIS_PASSWORD=change-me-redis-password

# First PlatformAdmin, created on first start if absent. Password: 12+ characters.
PAYFLOW_ADMIN_EMAIL=admin@payflow.test
PAYFLOW_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Host ports (change if they clash with other local services)
PAYFLOW_DB_PORT=5432
PAYFLOW_REDIS_PORT=6379
PAYFLOW_API_PORT=8080
PAYFLOW_HTTPS_PORT=8443

# Server secret mixed into API key hashes (base64, 32+ bytes):  openssl rand -base64 32
API_KEY_PEPPER=change-me-base64-32-bytes

# AES-256 master key (base64, exactly 32 bytes) encrypting webhook secrets and the cookie key ring:
#   openssl rand -base64 32
PAYFLOW_MASTER_KEY=change-me-base64-32-bytes
PAYFLOW_SINK_PORT=8090
