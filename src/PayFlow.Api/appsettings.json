{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 10,
    "AuthenticationWindow": "00:01:00"
  },
  "ReverseProxy": {
    "TrustedNetworks": []
  }
}
