<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1515: types in app (non-library) code may be public for testability/composition -->
    <!-- CA1848/CA1873: LoggerMessage source-gen is not required for every log call -->
    <!-- CA2007: no ConfigureAwait in ASP.NET Core app code -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA2007;CA1062;CA1716;CA1711;CA1724;CA1031;CA1305;CA1307;CA1309;CA1310;CA1863;CA1000;CA2225</NoWarn>
  </PropertyGroup>
</Project>
