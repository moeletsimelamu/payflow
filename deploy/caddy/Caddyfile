# Local HTTPS gateway. Caddy issues a certificate for "localhost" from its own local CA
# (stored in the caddy_data volume). Browsers will warn until that CA is trusted; for curl use -k.
# Phase 8 adds the Angular dashboard as static files behind this same origin.
{
	auto_https disable_redirects
}

https://localhost {
	tls internal

	# Caddy sets X-Forwarded-For and X-Forwarded-Proto; the API trusts them only from the gateway network.
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
